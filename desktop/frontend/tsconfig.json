{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@lib/*": [
        "./src/lib/*"
      ],
      "@wailsjs/*": [
        "./wailsjs/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "wailsjs/**/*.ts",
    "wailsjs/**/*.d.ts"
  ]
}
